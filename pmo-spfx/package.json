{
  "name": "pmo-spfx",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "scripts": {
    "build": "heft test --clean --production && heft package-solution --production",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "package": "heft package-solution --production",
    "start": "heft start --clean",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fluentui/react": "8.106.4",
    "@microsoft/sp-component-base": "1.24.1",
    "@microsoft/sp-core-library": "1.24.1",
    "@microsoft/sp-lodash-subset": "1.24.1",
    "@microsoft/sp-office-ui-fabric-core": "1.24.1",
    "@microsoft/sp-property-pane": "1.24.1",
    "@microsoft/sp-webpart-base": "1.24.1",
    "exceljs": "^4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.24.1",
    "@microsoft/eslint-plugin-spfx": "1.24.1",
    "@microsoft/sp-module-interfaces": "1.24.1",
    "@microsoft/spfx-heft-plugins": "1.24.1",
    "@microsoft/spfx-web-build-rig": "1.24.1",
    "@rushstack/heft": "1.3.2",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@types/webpack-env": "1.15.2",
    "css-loader": "7.1.2",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "prettier": "3.6.2",
    "ts-jest": "29.4.15",
    "typescript": "5.8.3"
  },
  "overrides": {
    "@rushstack/heft": "1.3.2",
    "qs": "6.15.2",
    "serialize-javascript": "7.1.3",
    "uuid": "11.1.1"
  },
  "resolutions": {
    "@types/react": "18.2.79"
  }
}
