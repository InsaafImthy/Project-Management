{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Modern PMO site page",
      "type": "msedge",
      "request": "launch",
      "url": "https://aufaitcloud.sharepoint.com/sites/ProjectManagementTool/SitePages/Home.aspx?loadSPFX=true&debugManifestsFile=https://localhost:4321/temp/manifests.js",
      "webRoot": "${workspaceRoot}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///.././src/*": "${webRoot}/src/*",
        "webpack:///../../../src/*": "${webRoot}/src/*",
        "webpack:///../../../../src/*": "${webRoot}/src/*",
        "webpack:///../../../../../src/*": "${webRoot}/src/*"
      },
      "runtimeArgs": ["--remote-debugging-port=9222", "-incognito"]
    }
  ]
}
